  "definitions": {
    "GenericReply": {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer",
          "description": "0 = operation completed, 0 != error"
        },
        "statusTxt": {
          "type": "string",
          "description": "the error description"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "fields": {
          "type": "string"
        }
      }
    },
    "fair": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "moa casa 2024"
        },
        "address": {
          "type": "string",
          "example": "nuova fiera di roma - ingresso nord"
        },
        "datefrom": {
          "type": "string",
          "example": "2024-05-28"
        },
        "dateto": {
          "type": "string",
          "example": "2024-06-01"
        },
        "team_id": {
          "type": "string",
          "example": ""
        }
      }
    },
    "lead": {
      "required": [
        "subject",
        "description"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "example": "moa casa 2026 - Paolo rossi"
        },
        "description": {
          "type": "string",
          "example": "contattare Paolo al numero 123456"
        },
        "name": {
          "type": "string",
          "example": "Paolo"
        },
        "lastname": {
          "type": "string",
          "example": "Rossi"
        },
        "email": {
          "type": "string",
          "example": "paolo.rossi@icona.it"
        },
        "phone": {
          "type": "string",
          "example": "123456"
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/contact"
      }
    },
    "contact": {
      "properties": {
        "EMAIL": {
          "type": "string",
          "example": "test@test.it"
        },
        "FIRST_NAME": {
          "type": "string",
          "example": "Amerigo"
        },
        "LAST_NAME": {
          "type": "string",
          "example": "Vespucci"
        }
      }
    }
  }
