    "/fair/lead/checkBusinessCard": {
      "post": {
        "summary": "analyze uploaded lead business card with Sophia vision.",
        "description": "Runs business card detection/extraction on a previously uploaded fair lead photo.",
        "consumes": "application/json",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "JWT token",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "image file path returned by /fair/lead/uploadPhoto",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "imageFilePath"
              ],
              "properties": {
                "imageFilePath": {
                  "type": "string",
                  "example": "/var/imh/smtp/tmp/fairs/201/12/12_1718289332_card.jpg"
                }
              }
            }
          }
        ],
        "tags": [
          "fair"
        ],
        "responses": {
          "200": {
            "description": "if no error returns business card extraction payload.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GenericReply"
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
