    "/ticket/export": {
      "get": {
        "summary": "Export tickets as CSV for Excel Power Query (advanced search columns, without description)",
        "description": "Returns UTF-8 CSV (same columns as advanced search exportticketcsv, excluding description). Filters by createdon. CSV delimiter follows operator/company preferences (default from PREF_CSV_DELIMITER_DEFAULT). On errors returns HTTP 200 JSON {\"status\":-1,\"statusTxt\":\"...\"}.",
        "produces": [
          "text/csv"
        ],
        "parameters": [
          {
            "name": "companyId",
            "in": "query",
            "description": "Deskoala company ID",
            "required": true,
            "type": "string"
          },
          {
            "name": "key",
            "in": "query",
            "description": "Deskoala WS Key with TICKET read permission",
            "required": true,
            "type": "string"
          },
          {
            "name": "login",
            "in": "query",
            "description": "Deskoala operator login who perform the operation",
            "required": true,
            "type": "string"
          },
          {
            "name": "date_from",
            "in": "query",
            "description": "date in iso format (yyyy-mm-dd)",
            "required": true,
            "type": "string"
          },
          {
            "name": "date_to",
            "in": "query",
            "description": "date in iso format (yyyy-mm-dd), inclusive end of day",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ticketing"
        ],
        "responses": {
          "200": {
            "description": "CSV UTF-8 on success (ricerca avanzata, senza Descrizione, tutti gli stati nel periodo). On error: JSON body with status -1 and statusTxt."
          },
          "default": {
            "description": "Unexpected error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
